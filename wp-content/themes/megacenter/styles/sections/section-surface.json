{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Donker vlak",
	"slug": "section-surface",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				}
			}
		}
	}
}
