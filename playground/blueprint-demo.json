{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Megacenter Rijssen – demo",
		"description": "Pitch-demo: blokthema \"megacenter\" + plugin \"megacenter-core\" met demo-inhoud. Alle inhoud is voorbeeldinhoud.",
		"author": "Bas",
		"categories": [
			"Demo"
		]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "nl_NL"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Megacenter Rijssen",
				"blogdescription": "FUN begint hier.",
				"timezone_string": "Europe/Amsterdam",
				"permalink_structure": "/%postname%/",
				"blog_public": "0"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/basvolgers/megacenter-wordpress-demo",
				"ref": "main",
				"refType": "branch",
				"path": "wp-content/plugins/megacenter-core"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/basvolgers/megacenter-wordpress-demo",
				"ref": "main",
				"refType": "branch",
				"path": "wp-content/themes/megacenter"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; if ( function_exists( 'megacenter_demo_seed' ) ) { megacenter_demo_seed(); } flush_rewrite_rules( false );"
		},
		{
			"step": "login",
			"username": "admin"
		}
	]
}
